# Khoffie — webserverinstellingen (Apache / LiteSpeed, standaard bij Vimexx/DirectAdmin)

# Geen mappenoverzicht tonen
Options -Indexes

# Interne bestanden nooit via de browser
<FilesMatch "\.(md|sql|sh|log|ini|lock|json)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>
RedirectMatch 404 /\.(git|github|claude)(/|$)

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Nette 404-pagina voor adressen die niet bestaan
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Eén vast adres voor zoekmachines: khoffie.nl gaat naar https://www.khoffie.nl
  # (http naar https regelt DirectAdmin zelf met "Force SSL"; de server ziet hier
  # niet betrouwbaar of een bezoek via https binnenkomt)
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTP_HOST} ^khoffie\.nl$ [NC]
  RewriteRule ^ https://www.khoffie.nl%{REQUEST_URI} [L,R=301]

  # /index.html is dezelfde pagina als / : doorsturen naar /
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
  RewriteRule ^index\.html$ https://www.khoffie.nl/ [L,R=301]
</IfModule>

# Sneller laden: tekstbestanden comprimeren
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml text/xml application/xml text/plain
</IfModule>

# Sneller laden: afbeeldingen, lettertypes, opmaak en scripts in de browser bewaren.
# Pagina's zelf niet, zodat wijzigingen direct zichtbaar zijn.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
